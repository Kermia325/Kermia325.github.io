---
import { HOME_ARTWORK } from '../consts';
---

<hero-parallax aria-hidden="true">
	<picture class="fallback">
		<source media="(max-width: 720px)" srcset={HOME_ARTWORK.mobile || HOME_ARTWORK.desktop} />
		<img src={HOME_ARTWORK.desktop} alt="" width={HOME_ARTWORK.width} height={HOME_ARTWORK.height} fetchpriority="high" />
	</picture>
	<div class="layers">
		<img class="back" src={HOME_ARTWORK.background} alt="" width={HOME_ARTWORK.width} height={HOME_ARTWORK.height} />
		<img class="character" src={HOME_ARTWORK.character} alt="" width={HOME_ARTWORK.width} height={HOME_ARTWORK.height} />
	</div>
</hero-parallax>

<script>
	class HeroParallax extends HTMLElement {
		private controller?: AbortController;
		private frame = 0;
		connectedCallback() {
			this.controller?.abort();
			this.controller = new AbortController();
			const { signal } = this.controller;
			const hero = this.closest<HTMLElement>('.hero');
			const images = Array.from(this.querySelectorAll<HTMLImageElement>('.layers img'));
			if (!hero || images.length !== 2) return;
			const media = matchMedia('(min-width: 721px) and (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)');
			let ready = false;
			let x = 0, y = 0, targetX = 0, targetY = 0;
			const paint = () => {
				// 背景最多 5/3 px，人物最多 12/7 px，同向不同速度形成景深。
				images[0].style.transform = `translate3d(${x * 5}px, ${y * 3}px, 0)`;
				images[1].style.transform = `translate3d(${x * 12}px, ${y * 7}px, 0)`;
			};
			const reset = () => {
				cancelAnimationFrame(this.frame); this.frame = 0;
				x = y = targetX = targetY = 0; paint();
			};
			const tick = () => {
				x += (targetX - x) * .09; y += (targetY - y) * .09;
				if (Math.abs(targetX - x) + Math.abs(targetY - y) < .001) {
					x = targetX; y = targetY; paint(); this.frame = 0; return;
				}
				paint(); this.frame = requestAnimationFrame(tick);
			};
			const schedule = () => { if (!this.frame) this.frame = requestAnimationFrame(tick); };
			const sync = () => {
				ready = images.every(image => image.complete && image.naturalWidth > 0);
				this.classList.toggle('enabled', ready && media.matches);
				reset();
			};
			images.forEach(image => {
				image.addEventListener('load', sync, { signal });
				image.addEventListener('error', () => { ready = false; this.classList.remove('enabled'); reset(); }, { signal });
			});
			hero.addEventListener('pointermove', event => {
				if (!ready || !media.matches || event.pointerType !== 'mouse') return;
				const rect = hero.getBoundingClientRect();
				targetX = Math.max(-1, Math.min(1, ((event.clientX - rect.left) / rect.width - .5) * 2));
				targetY = Math.max(-1, Math.min(1, ((event.clientY - rect.top) / rect.height - .5) * 2));
				schedule();
			}, { signal, passive: true });
			hero.addEventListener('pointerleave', () => { targetX = targetY = 0; schedule(); }, { signal });
			media.addEventListener('change', sync, { signal });
			window.addEventListener('resize', reset, { signal, passive: true });
			window.addEventListener('blur', reset, { signal });
			document.addEventListener('visibilitychange', () => { if (document.hidden) reset(); }, { signal });
			sync();
		}
		disconnectedCallback() { this.controller?.abort(); cancelAnimationFrame(this.frame); this.frame = 0; }
	}
	if (!customElements.get('hero-parallax')) customElements.define('hero-parallax', HeroParallax);
</script>

<style>
	hero-parallax { position: absolute; inset: 0; z-index: -3; pointer-events: none; overflow: hidden; }
	.fallback, .layers { position: absolute; inset: 0; }
	img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 52% center; border-radius: 0; }
	/* 两层使用相同画布和裁切；预留 18px 防止平移时露出边缘。 */
	.layers { inset: -18px; visibility: hidden; }
	.enabled .layers { visibility: visible; }
	.enabled .fallback { visibility: hidden; }
	.enabled .layers img { will-change: transform; }
	@media (max-width: 720px) { img { object-position: 51% top; } }
	@media (prefers-reduced-motion: reduce), (hover: none), (pointer: coarse) {
		.enabled .layers { visibility: hidden; }
		.enabled .fallback { visibility: visible; }
	}
</style>
