---
import { SITE_AUTHOR, SITE_TITLE } from '../consts';
import MusicPlayer from './MusicPlayer.astro';

const today = new Date();
---

<footer>
	<p>{SITE_TITLE}</p>
	<p>&copy; {today.getFullYear()} {SITE_AUTHOR}. 保留所有权利。</p>
</footer>

<MusicPlayer />

<style>
	footer {
		padding: 2em 1em 6em;
		background: linear-gradient(var(--gray-gradient)) no-repeat;
		color: rgb(var(--gray));
		text-align: center;
	}
	footer p {
		margin: 0.25em 0;
	}
</style>
