---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { HOME_ARTWORK, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="zh-CN">
	<head><BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} /></head>
	<body>
		<Header />
		<main class="home-page">
			<section class="hero" aria-labelledby="welcome-title">
				<div class="flower-shadow" aria-hidden="true"></div>
				<div class="hero-copy">
					<p class="eyebrow">KERMIA’S PERSONAL DIARY</p>
					<h1 id="welcome-title">在旋律之间，<br />收藏<span>生活的回响。</span></h1>
					<p class="intro">你好，我是 Kermia。<br />这里记录学习、技术探索，还有那些想要反复聆听的瞬间。</p>
					<div class="actions">
						<a class="primary" href="/blog">阅读文章</a>
						<a class="secondary" href="/about">关于我</a>
					</div>
					<div class="collected">
						<span class="line"></span>
						<p>音乐 / 学习 / 日常<br /><small>把喜欢的事物，慢慢写进生活。</small></p>
					</div>
				</div>
				<figure class="hero-art">
					<picture>
						<source media="(max-width: 720px)" srcset={HOME_ARTWORK.mobile || HOME_ARTWORK.desktop} />
						<img src={HOME_ARTWORK.desktop} alt="millsage《鳴らす》人物拼贴视觉" width="800" height="800" fetchpriority="high" />
					</picture>
				</figure>
				<div class="visual-notes" aria-label="millsage 视觉收藏">
					<figure><img src="/images/millsage/flowers.png" alt="《起死開戦》花卉封面" width="600" height="600" /><figcaption>花与旋律</figcaption></figure>
					<figure><img src="/images/millsage/stellar.jpg" alt="《Stellar Stellar》星空视觉" width="3840" height="2160" /><figcaption>星光与回响</figcaption></figure>
				</div>
				<p class="fan-note">Kermia 的个人博客 · millsage 非官方主题</p>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.home-page { width: 100%; max-width: none; margin: 0; padding: 0; }
	.hero { position: relative; isolation: isolate; display: grid; grid-template-columns: 0.85fr 1.15fr; align-items: center; gap: 2vw; min-height: calc(100svh - 70px); box-sizing: border-box; padding: 4rem max(6vw, 2rem) 9rem; overflow: hidden; background: #f6f5fa; color: #40384f; }
	.flower-shadow { position: absolute; inset: 0; z-index: -1; background: linear-gradient(90deg, rgba(249,248,252,.88), rgba(249,248,252,.7)), url('/images/millsage/carnation.jpg') left center / cover; opacity: .9; }
	.hero-copy { position: relative; z-index: 2; max-width: 34rem; padding-left: 1rem; }
	.eyebrow { font-size: .75rem; letter-spacing: .2em; color: #756883; margin: 0 0 2rem; }
	.theme-label { display: inline-flex; gap: .6rem; align-items: center; color: #72548e; font-size: .9rem; margin: 0 0 1.5rem; }
	.theme-label span { font-size: 1.6rem; }
	h1 { font-size: clamp(2.2rem, 3.65vw, 4rem); line-height: 1.42; letter-spacing: -.04em; color: #3f354f; font-family: 'Noto Serif SC', 'Songti SC', SimSun, serif; font-weight: 500; margin: 0; }
	h1 span { color: #85649b; }
	.intro { font-size: 1rem; line-height: 2; color: #665f73; margin: 1.6rem 0 2rem; }
	.actions { display: flex; flex-wrap: wrap; gap: .85rem; }
	.actions a { padding: .7rem 1.6rem; border: 1px solid #79618f; border-radius: 5px; text-decoration: none; font-size: .95rem; transition: background .2s, transform .2s; }
	.primary { background: #69507f; color: white; box-shadow: 0 6px 18px #69507f22; }
	.primary:hover { background: #503b65; color: white; transform: translateY(-2px); }
	.secondary { color: #614a78; background: #ffffff85; }
	.secondary:hover { background: white; }
	.collected { display: flex; gap: 1rem; align-items: center; margin-top: 2.5rem; font-size: .85rem; color: #74687f; }
	.collected p { margin: 0; line-height: 1.9; }
	.collected small { font-size: .8rem; }
	.line { height: 2.5rem; width: 2px; background: #b9a3ca; }
	.hero-art { position: relative; z-index: 1; margin: 0; width: 100%; max-width: 740px; justify-self: center; transform: rotate(2deg); padding: .6rem .6rem 0; box-sizing: border-box; background: #fff; box-shadow: 0 22px 65px #59406726; border: 1px solid #e4ddea; }
	.hero-art::before { content: ''; position: absolute; z-index: 2; width: 6rem; height: 1.6rem; top: -.8rem; left: 42%; background: #d8cce1bb; transform: rotate(-7deg); }
	.hero-art img { display: block; width: 100%; height: auto; border-radius: 0; }
	.visual-notes { position: absolute; bottom: 2.5rem; left: max(7vw, 2rem); display: flex; gap: 1rem; }
	.visual-notes figure { display: flex; align-items: center; gap: .75rem; margin: 0; padding: .4rem .8rem .4rem .4rem; background: #ffffffb8; border: 1px solid #e0d9e8; box-shadow: 0 3px 12px #4e3b6410; }
	.visual-notes img { width: 3rem; height: 3rem; object-fit: cover; border-radius: 0; }
	.visual-notes figcaption { font-size: .8rem; color: #73627e; }
	.fan-note { position: absolute; bottom: 2.7rem; right: 6vw; margin: 0; color: #766c81; font-size: .75rem; }
	@media (max-width: 1000px) { .hero { padding-left: 4.5rem; padding-right: 2rem; } .visual-notes { left: 4.5rem; } .fan-note { bottom: 1rem; } }
	@media (max-width: 720px) {
		.hero { grid-template-columns: 1fr; gap: 2.5rem; padding: 2.5rem 1.5rem 2rem; min-height: 100svh; }
		.hero-art { grid-row: 1; width: min(100%, 440px); transform: rotate(1deg); }
		.hero-copy { padding: 0 .5rem 0 1.5rem; max-width: 100%; }
		h1 { font-size: clamp(2rem, 7vw, 3rem); }
		.eyebrow { margin-bottom: 1rem; }
		.theme-label { margin-bottom: .8rem; }
		.collected { margin-top: 1.8rem; }
		.visual-notes { position: static; flex-wrap: wrap; padding-left: 1.5rem; gap: .7rem; }
		.fan-note { position: static; text-align: center; }
	}
	@media (prefers-reduced-motion: reduce) { .actions a { transition: none; } .primary:hover { transform: none; } }
</style>
