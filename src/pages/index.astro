---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import HeroParallax from '../components/HeroParallax.astro';
---

<!doctype html>
<html lang="zh-CN">
	<head><BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} /></head>
	<body class="night-home">
		<Header />
		<main class="home-page">
			<section class="hero" aria-labelledby="welcome-title">
				<HeroParallax />
				<div class="shade" aria-hidden="true"></div>
				<div class="hero-copy">
					<p class="eyebrow"><span aria-hidden="true">✦</span> UNDER THE SAME STARS</p>
					<h1 id="welcome-title">Kermia<span>在星光里，记录回响。</span></h1>
					<p class="intro">学习、音乐，与日常生活的片段。<br />把值得珍藏的瞬间，写进这片夜空。</p>
					<div class="actions">
						<a class="primary" href="/blog">阅读文章 <span aria-hidden="true">↗</span></a>
						<a class="secondary" href="/about">关于我 <span aria-hidden="true">↗</span></a>
					</div>
				</div>
				<div class="night-caption"><span>01 / NIGHT NOTES</span><span>让喜欢的事物，闪闪发光。</span></div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.home-page { width: 100%; max-width: none; margin: 0; padding: 0; }
	.hero { position: relative; isolation: isolate; min-height: 100svh; box-sizing: border-box; overflow: hidden; display: flex; align-items: flex-end; padding: 9rem 7vw 8rem; color: #f4eaff; background: #08091e; }
	.shade { position: absolute; inset: 0; pointer-events: none; }
	.shade { z-index: -2; background: linear-gradient(90deg, #070817d9 0%, #09091d80 30%, transparent 65%), linear-gradient(0deg, #070817ed 0%, #08082020 55%, #08081b85 100%); }
	.hero-copy { width: min(440px, 100%); padding: 1.5rem 0; text-shadow: 0 2px 18px #060419; }
	.eyebrow { font: .6rem monospace; letter-spacing: .2em; color: #dcc0f4; margin: 0 0 1.3rem; }
	.eyebrow span { color: #d5bb77; font-size: 1rem; margin-right: .6rem; }
	h1 { color: #f6e7ff; font: 400 clamp(3.8rem, 7vw, 7rem)/1 Georgia, serif; letter-spacing: -.05em; margin: 0; }
	h1 span { display: block; font: 400 clamp(1.1rem, 2vw, 1.65rem)/1.8 'Songti SC', SimSun, serif; letter-spacing: .12em; margin-top: 1rem; }
	.intro { margin: 1.3rem 0 1.8rem; color: #dbd3ec; font-size: .82rem; line-height: 2; }
	.actions { display: flex; flex-wrap: wrap; gap: .75rem; }
	.actions a { display: flex; align-items: center; gap: 1.8rem; padding: .65rem 1.1rem; border: 1px solid #b998df; color: #f5eaff; text-decoration: none; font-size: .78rem; background: #19102bbd; transition: background .2s, box-shadow .2s; }
	.actions .primary { background: #715099a8; }
	.actions a:hover { background: #705099; box-shadow: 0 0 22px #ab70e544; }
	.actions a:focus-visible { outline: 2px solid #f4d9ff; outline-offset: 5px; }
	.night-caption { position: absolute; bottom: 3.3rem; left: 7vw; display: flex; gap: 1.5rem; font-size: .58rem; color: #c2b4d7; letter-spacing: .1em; }
	.night-caption span:first-child { font-family: monospace; }
	@media (max-width: 720px) {
		.hero { min-height: 100svh; padding: max(22rem, 47svh) 1.8rem 7rem; }
		.shade { background: linear-gradient(0deg, #070817 0%, #080820c9 36%, #08082020 73%, #08081b80 100%); }
		.hero-copy { width: 100%; padding: 1rem 0; }
		h1 { font-size: clamp(3rem, 14vw, 4.5rem); }
		.night-caption { left: 1.8rem; bottom: 1.8rem; flex-direction: column; gap: .3rem; }
	}
	@media (prefers-reduced-motion: reduce) {
		.actions a { transition: none; }
	}
</style>
