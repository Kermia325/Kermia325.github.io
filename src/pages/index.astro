---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { HOME_ARTWORK, SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const heroStyle = `--hero-desktop-image: ${HOME_ARTWORK.desktop ? `url("${HOME_ARTWORK.desktop}")` : 'none'}; --hero-mobile-image: ${HOME_ARTWORK.mobile ? `url("${HOME_ARTWORK.mobile}")` : 'none'};`;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body class="home-body">
		<Header />
		<main class="home-page">
			<section class="home-hero" style={heroStyle} aria-labelledby="welcome-title">
				<div class="paper-grid" aria-hidden="true"></div>
				<div class="sticker sticker-star" aria-hidden="true">✦</div>
				<div class="sticker sticker-heart" aria-hidden="true">♥</div>
				<div class="memo memo-top" aria-hidden="true">今日也要慢慢来</div>

				<div class="hero-content">
					<p class="eyebrow">KERMIA'S LITTLE CORNER</p>
					<h1 id="welcome-title">Kermia 的<br /><em>个人博客</em></h1>
					<p class="hero-copy">记录学习、技术探索与日常生活的个人空间。把想法写成小小的手账，也把成长好好收藏。</p>
					<div class="hero-actions" aria-label="站内入口">
						<a class="primary-action" href="/blog">阅读文章 <span aria-hidden="true">→</span></a>
						<a class="secondary-action" href="/about">认识 Kermia</a>
					</div>
					<p class="hero-note">✿ 主页背景等待你的原创插画入住</p>
				</div>

				<div class="scrap-card" aria-hidden="true">
					<span class="scrap-card__tape"></span>
					<span>learning<br />in progress</span>
				</div>
				<div class="stamp" aria-hidden="true">K<br />2026</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.home-page {
		width: auto;
		max-width: none;
		margin: 0;
		padding: 0;
	}
	.home-hero {
		position: relative;
		display: grid;
		min-height: calc(100svh - 5rem);
		overflow: hidden;
		place-items: center;
		isolation: isolate;
		background-color: #fbf7f3;
		background-image:
			linear-gradient(90deg, rgba(255, 250, 246, 0.94) 0%, rgba(255, 250, 246, 0.67) 53%, rgba(255, 250, 246, 0.88) 100%),
			var(--hero-desktop-image),
			radial-gradient(circle at 76% 22%, rgba(237, 194, 210, 0.44) 0 9%, transparent 9.25%),
			radial-gradient(circle at 83% 65%, rgba(178, 204, 214, 0.52) 0 13%, transparent 13.25%);
		background-position: center;
		background-size: cover;
	}
	.paper-grid {
		position: absolute;
		z-index: -1;
		inset: 0;
		opacity: 0.48;
		background-image: linear-gradient(rgba(97, 124, 147, 0.09) 1px, transparent 1px), linear-gradient(90deg, rgba(97, 124, 147, 0.09) 1px, transparent 1px);
		background-size: 2rem 2rem;
		mask-image: linear-gradient(90deg, black, transparent 85%);
	}
	.hero-content {
		z-index: 1;
		width: min(39rem, calc(100% - 3rem));
		margin: 5rem auto 4rem;
		padding: clamp(1.8rem, 5vw, 4rem);
		border: 1px solid rgba(255, 255, 255, 0.75);
		border-radius: 1.5rem;
		background: rgba(255, 252, 249, 0.6);
		box-shadow: 0 1.5rem 4rem rgba(78, 86, 108, 0.12);
		backdrop-filter: blur(8px);
	}
	.eyebrow {
		margin: 0 0 1rem;
		color: #6d8199;
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.16em;
	}
	h1 {
		margin: 0;
		color: #3e4c66;
		font-size: clamp(3.4rem, 8vw, 6.8rem);
		letter-spacing: -0.06em;
		line-height: 0.92;
	}
	h1 em {
		color: #d482a6;
		font-family: Georgia, 'Times New Roman', serif;
		font-size: 0.74em;
		font-weight: 400;
		letter-spacing: -0.03em;
	}
	.hero-copy {
		max-width: 31rem;
		margin: 1.5rem 0 0;
		color: #596983;
		font-size: clamp(1rem, 2vw, 1.2rem);
	}
	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.8rem;
		margin-top: 2rem;
	}
	.hero-actions a {
		border-radius: 999px;
		font-weight: 700;
		text-decoration: none;
	}
	.primary-action {
		padding: 0.75rem 1.2rem;
		background: #5f809d;
		box-shadow: 0 0.35rem 0 #426985;
		color: white;
	}
	.primary-action:hover {
		transform: translateY(2px);
		box-shadow: 0 0.18rem 0 #426985;
		color: white;
	}
	.secondary-action {
		padding: 0.7rem 1.15rem;
		border: 1px solid #b9cad9;
		background: rgba(255, 255, 255, 0.7);
		color: #5f7189;
	}
	.secondary-action:hover {
		background: white;
		color: #3f5875;
	}
	.hero-note {
		margin: 2rem 0 0;
		color: #a2788e;
		font-size: 0.83rem;
	}
	.sticker,
	.memo,
	.scrap-card,
	.stamp {
		position: absolute;
		z-index: 1;
		user-select: none;
	}
	.sticker {
		display: grid;
		width: 3.5rem;
		height: 3.5rem;
		place-items: center;
		border-radius: 50%;
		box-shadow: 0 0.5rem 1rem rgba(93, 109, 133, 0.14);
		font-size: 1.45rem;
	}
	.sticker-star {
		top: 17%;
		left: 11%;
		background: #fae6ab;
		color: #9a7b31;
		transform: rotate(-12deg);
	}
	.sticker-heart {
		right: 12%;
		bottom: 18%;
		background: #f6d4df;
		color: #c76f92;
		transform: rotate(10deg);
	}
	.memo {
		top: 18%;
		right: 12%;
		padding: 0.7rem 1rem;
		border-radius: 0.25rem;
		background: #edf3e3;
		box-shadow: 0 0.6rem 1.4rem rgba(93, 109, 133, 0.16);
		color: #6d7b5e;
		font-size: 0.85rem;
		transform: rotate(5deg);
	}
	.scrap-card {
		right: 20%;
		bottom: 12%;
		display: grid;
		width: 8.8rem;
		height: 7.4rem;
		place-items: center;
		border: 0.55rem solid white;
		background: linear-gradient(135deg, #dce9ef, #f6dce7);
		box-shadow: 0 0.8rem 1.5rem rgba(93, 109, 133, 0.2);
		color: #6d8199;
		font-family: Georgia, serif;
		font-size: 1.05rem;
		line-height: 1.1;
		text-align: center;
		transform: rotate(-6deg);
	}
	.scrap-card__tape {
		position: absolute;
		top: -0.85rem;
		width: 3.8rem;
		height: 1.35rem;
		background: rgba(249, 222, 166, 0.72);
		transform: rotate(5deg);
	}
	.stamp {
		bottom: 9%;
		left: 13%;
		display: grid;
		width: 4.2rem;
		height: 4.2rem;
		place-items: center;
		border: 2px dashed #bb839c;
		border-radius: 50%;
		color: #bb839c;
		font-size: 0.75rem;
		font-weight: 700;
		line-height: 1.1;
		text-align: center;
		transform: rotate(-14deg);
	}
	@media (max-width: 720px) {
		.home-hero {
			min-height: calc(100svh - 6.8rem);
			background-image:
				linear-gradient(180deg, rgba(255, 250, 246, 0.82), rgba(255, 250, 246, 0.93)),
				var(--hero-mobile-image),
				radial-gradient(circle at 80% 14%, rgba(237, 194, 210, 0.42) 0 10%, transparent 10.25%);
		}
		.hero-content {
			margin: 3.5rem auto;
		}
		.memo {
			top: 11%;
			right: 7%;
		}
		.sticker-star {
			left: 6%;
		}
		.scrap-card {
			right: 6%;
			bottom: 9%;
			width: 6.6rem;
			height: 5.6rem;
			font-size: 0.8rem;
		}
		.stamp,
		.sticker-heart {
			display: none;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.primary-action {
			transition: none;
		}
	}
</style>
