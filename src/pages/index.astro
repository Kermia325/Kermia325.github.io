---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="intro" aria-labelledby="welcome-title">
				<p class="eyebrow">欢迎来到这里</p>
				<h1 id="welcome-title">你好，我是 Kermia。</h1>
				<p>这是一个记录学习、技术探索与日常生活的个人空间。</p>
				<p>我会把思考、实践和感兴趣的事物慢慢整理在这里，也为未来的二次元手账风格留下充足的延展空间。</p>
				<div class="actions">
					<a class="button" href="/blog">阅读文章</a>
					<a class="text-link" href="/about">了解更多 →</a>
				</div>
			</section>

			<section class="recent-posts" aria-labelledby="recent-posts-title">
				<h2 id="recent-posts-title">最近文章</h2>
				<p class="empty-state">文章正在整理中，敬请期待。</p>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.intro {
		padding: 1em 0 3em;
	}
	.eyebrow,
	.empty-state {
		color: rgb(var(--gray));
	}
	.eyebrow {
		margin-bottom: 0.25em;
		font-size: 0.9em;
	}
	.actions {
		display: flex;
		align-items: center;
		gap: 1em;
		margin-top: 1.5em;
	}
	.button {
		display: inline-block;
		padding: 0.65em 1em;
		border-radius: 8px;
		background: var(--accent);
		color: white;
		text-decoration: none;
	}
	.button:hover {
		background: var(--accent-dark);
		color: white;
	}
	.text-link {
		text-decoration: none;
	}
	.recent-posts {
		padding-top: 1em;
		border-top: 1px solid rgb(var(--gray-light));
	}
	@media (max-width: 720px) {
		.intro {
			padding-top: 0;
		}
	}
</style>
