---
import { NAV_ITEMS, SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav aria-label="主导航">
		<a class="site-mark" href="/" aria-label={`返回${SITE_TITLE}首页`}>
			<span class="site-mark__badge" aria-hidden="true">K</span>
			<span class="site-mark__name">Kermia<br /><small>personal diary</small></span>
		</a>
		<div class="internal-links">
			{NAV_ITEMS.map((item) => <HeaderLink href={item.href}>{item.label}</HeaderLink>)}
		</div>
	</nav>
</header>

<style>
	header {
		position: sticky;
		z-index: 8;
		top: 0;
		padding: 0.7rem clamp(1rem, 4vw, 3rem);
		border-bottom: 1px solid rgba(168, 190, 207, 0.46);
		background: rgba(255, 252, 249, 0.78);
		box-shadow: 0 0.4rem 1.4rem rgba(86, 101, 126, 0.08);
		backdrop-filter: blur(14px);
	}
	nav,
	.site-mark,
	.internal-links {
		display: flex;
		align-items: center;
	}
	nav {
		justify-content: space-between;
		gap: 1.5rem;
		max-width: 82rem;
		margin: auto;
	}
	.site-mark {
		gap: 0.55rem;
		color: #526f8d;
		line-height: 1;
		text-decoration: none;
	}
	.site-mark__badge {
		display: grid;
		width: 2.15rem;
		height: 2.15rem;
		place-items: center;
		border-radius: 0.7rem 0.9rem 0.7rem 0.9rem;
		background: #f7d9e6;
		box-shadow: 0.16rem 0.16rem 0 #d9e5ee;
		color: #557797;
		font-family: Georgia, serif;
		font-size: 1.15rem;
		font-weight: 700;
		transform: rotate(-5deg);
	}
	.site-mark__name {
		font-size: 0.9rem;
		font-weight: 700;
	}
	.site-mark small {
		color: #92a1b3;
		font-size: 0.58rem;
		font-weight: 400;
		letter-spacing: 0.08em;
	}
	.internal-links {
		gap: 0.2rem;
	}
	.internal-links :global(a) {
		padding: 0.55rem 0.8rem;
		border: 1px solid transparent;
		border-radius: 999px;
		color: #5b718b;
		font-size: 0.9rem;
		font-weight: 700;
		text-decoration: none;
	}
	.internal-links :global(a:hover),
	.internal-links :global(a.active) {
		border-color: #d4e0ea;
		background: rgba(255, 255, 255, 0.75);
		color: #456b8d;
	}
	@media (max-width: 560px) {
		header {
			padding: 0.6rem 0.75rem;
		}
		nav {
			align-items: flex-start;
			gap: 0.5rem;
		}
		.site-mark__name {
			display: none;
		}
		.internal-links {
			gap: 0;
		}
		.internal-links :global(a) {
			padding: 0.5rem 0.55rem;
			font-size: 0.82rem;
		}
	}
</style>
